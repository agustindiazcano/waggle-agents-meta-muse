[importlinter]
root_package = fixture_pkg

[importlinter:contract:sim-control-no-llm-side]
name = fixture: sim and control must not import llm, governance, maintenance or mcp_server
type = forbidden
source_modules =
    fixture_pkg.sim
    fixture_pkg.control
forbidden_modules =
    fixture_pkg.llm
    fixture_pkg.governance
    fixture_pkg.maintenance
    fixture_pkg.mcp_server

[importlinter:contract:mcp-server-no-governance]
name = fixture: mcp_server must not import governance
type = forbidden
source_modules =
    fixture_pkg.mcp_server
forbidden_modules =
    fixture_pkg.governance

[importlinter:contract:control-no-ground-truth]
name = fixture: control must not import ground truth, sensors or the detector
type = forbidden
source_modules =
    fixture_pkg.control
forbidden_modules =
    fixture_pkg.sim.world
    fixture_pkg.sim.state
    fixture_pkg.sim.streams
    fixture_pkg.sim.engine
    fixture_pkg.sim.robots
    fixture_pkg.sim.humans
    fixture_pkg.sim.detector
    fixture_pkg.sim.sensors
    fixture_pkg.sim.scenarios
    fixture_pkg.sim.scripted
