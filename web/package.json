{
  "name": "waggle-viewer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Waggle Hive technical viewer, replay file mode",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/*.test.ts\" \"test/*.test.mjs\"",
    "models:sync": "node tools/model_files.mjs",
    "test:browser": "playwright test",
    "test:models": "playwright test --config playwright.models.config.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/three": "0.170.0",
    "three": "0.170.0",
    "typescript": "5.8.3",
    "vite": "5.4.11"
  }
}
