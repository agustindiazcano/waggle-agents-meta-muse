# Names only. Copy to .env and fill in the values locally. Never commit .env.

# Meta Model API (Muse Spark, Muse Voice Transcribe, vision)
META_API_KEY=
META_API_BASE_URL=
# Model ids come from the API model list (GET /v1/models), never from code.
META_MODEL_ID=
META_VOICE_MODEL_ID=
# Set to true to use the cheaper contributor tier. Allowed only because all data is synthetic.
META_USE_CONTRIBUTOR_TIER=

# Baseten (Muse Spark Open 1026: court member 2, advisors, organizer)
BASETEN_API_KEY=
BASETEN_MODEL_ID=

# Modal (Muse Glimmer 30B: court member 3 and guard; fallback host for Muse Spark Open)
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_ENDPOINT_URL=
MODAL_GLIMMER_MODEL_ID=
MODAL_SPARK_OPEN_MODEL_ID=

# Vertex AI (secondary backup and the non-Muse member of E4 configuration D).
# Authenticates with a service account file, never a key in the repository.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=
VERTEX_MODEL_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# Meshy (3D assets)
MESHY_API_KEY=

# Langfuse (optional tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Hard spending caps per provider, USD (balance minus a 10 percent reserve)
META_SPEND_CAP_USD=
BASETEN_SPEND_CAP_USD=
MODAL_SPEND_CAP_USD=
VERTEX_SPEND_CAP_USD=

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=