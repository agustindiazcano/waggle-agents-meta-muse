# Names only. Copy to .env and fill in the values locally. Never commit .env.

# Meta Model API (Muse Spark, Muse Voice Transcribe, Prompt Guard)
META_API_KEY=
META_API_BASE_URL=

# Baseten (Muse Spark Open 1026)
BASETEN_API_KEY=
BASETEN_MODEL_ID=

# Third court family (see docs/DECISIONS.md, ADR-007)
GEMINI_API_KEY=

# Modal
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Meshy (3D assets)
MESHY_API_KEY=

# Langfuse (optional tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Hard spending caps per provider, USD
META_SPEND_CAP_USD=
BASETEN_SPEND_CAP_USD=
GEMINI_SPEND_CAP_USD=
MODAL_SPEND_CAP_USD=

# Database
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
